# Quantis - frontend Vite

# Backend Quantis (Node) — lưu dataset/workflow, proxy Archive & proxy phân tích Python
VITE_QUANTIS_API_URL=http://localhost:3001

# LLM (vLLM, OpenAI-compatible): upstream do backend lưu (Cấu hình kết nối / ollamaUpstreamUrl) hoặc OLLAMA_URL trên server
# (vd. http://<gateway>:8037/vllm; seckey: OLLAMA_SECKEY hoặc ollamaSeckey trong Cấu hình kết nối). Embedding vẫn dùng Ollama.
# Khi không có backend Node: dev có thể gọi trực tiếp (CORS tùy trình duyệt):
# VITE_OLLAMA_URL=http://127.0.0.1:8000
# VITE_QUANTIS_AI_MODEL=qwen3.5-35b-a3b-int4
